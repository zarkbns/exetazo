# ---------------------------------------------------------------------------
# Server-side configuration — never shipped to the extension, never committed.
# Copy to .env for local development. All of these are optional: without
# OPENAI_API_KEY the server runs rules-only, which is the mode that makes the
# score reproducible (see README, "Reproducible demo").
# ---------------------------------------------------------------------------

# Enables semantic analysis (AI proposals, not score-affecting).
OPENAI_API_KEY=
# OpenAI-compatible endpoint and model (see server/llm/openai.ts).
OPENAI_BASE_URL=
OPENAI_MODEL=

# Local server port (default 8787).
PORT=8787

# ---------------------------------------------------------------------------
# Extension build configuration — not a secret. It is only the API origin.
# ---------------------------------------------------------------------------
# Unset  → local development build: http://127.0.0.1:8787
# Set    → production build. Must be an https:// origin (http://127.0.0.1 and
#          http://localhost are accepted for local development only). The value
#          is baked into the bundle as the API base and becomes the single
#          entry in the built manifest's host_permissions.
#
#   EXETAZO_API_ORIGIN=https://your-api-host.example.com npm run build:extension
EXETAZO_API_ORIGIN=
